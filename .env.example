# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=3000
# HOST=0.0.0.0
# Where the SQLite database and uploaded assets live (mount a persistent disk here).
DATA_DIR=data
# Optional: explicit database file (defaults to $DATA_DIR/encore.db).
# DB_FILE=data/encore.db
# Max upload size for assets, in MB.
ASSET_MAX_MB=15

# --- Access ---
# Shared team password. When set, the app and API need a login cookie.
# Guest RSVP / survey links still work (limited to those operations).
APP_PASSWORD=
# Optional: secret used to sign the login cookie (defaults to APP_PASSWORD).
SESSION_SECRET=

# --- Claude ---
# Server-side only; read by the Anthropic SDK. Never sent to the browser.
ANTHROPIC_API_KEY=
# Set to 1 for offline demo/test mode: no network calls, canned replies.
ENCORE_FAKE_AI=0
# GIF search for feed comments (server/gifs.js). Set one; with neither, the GIF button offers our own stickers.
# GIPHY_API_KEY=
# TENOR_API_KEY=

# --- Slack (optional) ---
# Bot token (chat:write, users:read, users:read.email scopes) enables both tools.
SLACK_BOT_TOKEN=
# Channel used when a message has no channel/user_email (e.g. the PM job's nudges).
SLACK_DEFAULT_CHANNEL=
# Without a bot token, an incoming webhook enables slack_send_message only.
SLACK_WEBHOOK_URL=

# --- Linear (optional) ---
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# --- HubSpot (optional) ---
# Private app token. Scopes: crm.objects.contacts.read/write, crm.objects.deals.read,
# crm.objects.companies.read, crm.objects.marketing_events.read/write.
HUBSPOT_TOKEN=
# Organizer name on marketing events Encore creates (default "Encore").
# HUBSPOT_EVENT_ORGANIZER=

# --- Salesforce (optional) ---
# My Domain URL, e.g. https://yourcompany.my.salesforce.com
SF_INSTANCE_URL=
# Either a ready access token...
SF_ACCESS_TOKEN=
# ...or a connected app with the client-credentials flow enabled (and a run-as user).
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# SF_API_VERSION=v61.0

# --- Daily project-manager job ---
# Cron expression (or "off" to disable) and IANA time zone.
PM_CRON=0 8 * * 1-5
PM_TZ=America/Chicago
