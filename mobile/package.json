{
  "name": "pottery-lab-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Pottery Lab for iOS and Android: a Capacitor shell around the live site, with push, share, camera, calendar and haptics. See README.md.",
  "scripts": {
    "www": "node scripts/prepare-www.cjs",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#F2D48F' --iconBackgroundColorDark '#F2D48F' --splashBackgroundColor '#F7F1E8' --splashBackgroundColorDark '#15110E'",
    "sync": "npm run www && npx cap sync",
    "ios": "npm run sync && npx cap open ios",
    "android": "npm run sync && npx cap open android",
    "doctor": "npx cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/browser": "^7.0.1",
    "@capacitor/camera": "^7.0.1",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.1.1",
    "@capacitor/haptics": "^7.0.1",
    "@capacitor/ios": "^7.4.0",
    "@capacitor/push-notifications": "^7.0.1",
    "@capacitor/share": "^7.0.1",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@ebarooni/capacitor-calendar": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.0",
    "typescript": "^5.6.3"
  }
}
