{
  "name": "encore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node.js server for the Encore event studio single-page app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "icons": "node scripts/make-app-icons.cjs",
    "mobile:install": "npm --prefix mobile install",
    "mobile:sync": "npm --prefix mobile run sync",
    "mobile:assets": "npm --prefix mobile run assets",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:android": "npm --prefix mobile run android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@simplewebauthn/server": "^13.3.3",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "jspdf": "^2.5.1",
    "node-cron": "^4.6.0"
  }
}
